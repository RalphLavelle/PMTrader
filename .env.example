# Scheduled market analysis (disabled by default).
# Market ids live in api/src/agents/markets.json — not here.
AGENT_SCHEDULE_ENABLED=false
AGENT_SCHEDULE_INTERVAL_MS=3600000

# Research-dataset collector (Phase 1) — disabled by default.
# When true, runs an initial fetch then follows collector-schedule.json.
COLLECTOR_ENABLED=false
# Optional path to the schedule JSON.
# Relative paths resolve against the api/ package directory.
# Default: api/src/collector/collector-schedule.json
COLLECTOR_SCHEDULE_PATH=
# Optional default category filter when the schedule JSON does not set
# wideSweep.options.categories. Example: crypto
COLLECTOR_CATEGORIES=crypto

# Jupiter Prediction API key from https://developers.jup.ag/portal
# Optional for prototyping (keyless access is limited to 0.5 RPS).
JUPITER_API_KEY=
# Process-wide min gap between Jupiter HTTP calls (ms). Default 1100 with a key
# (~54/min), 2000 keyless. Lower only if your portal tier allows a higher rate.
# JUPITER_MIN_REQUEST_INTERVAL_MS=1100
# Retries after HTTP 429 before surfacing the error (default 2).
# JUPITER_429_MAX_RETRIES=2
# Base backoff after 429 in ms; multiplied by attempt (default 5000).
# JUPITER_429_RETRY_DELAY_MS=5000

MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=PMTrader
MONGODB_RUNS_COLLECTION=runs

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b-cloud

# Default wallet for "My history" queries (Solana public key).
OWNER_PUBKEY=

# API server port (default 3000).
PORT=3000

MONGODB_MARKET_SNAPSHOTS_COLLECTION=market_snapshots
MONGODB_ORDERBOOK_SNAPSHOTS_COLLECTION=orderbook_snapshots
MONGODB_TRADES_COLLECTION=trades
MONGODB_MARKET_LABELS_COLLECTION=market_labels

# Outcome labeller (Phase 3) — disabled by default.
# Finds collected markets that have settled, labels them, then scores any
# stored swarm run whose market has now resolved.
LABELLER_ENABLED=false
# Gap between passes (default 600000 ms = 10 minutes).
LABELLER_INTERVAL_MS=600000
# Markets checked per pass — one Jupiter request each, so keep this modest.
LABELLER_MARKET_BATCH_SIZE=5
# Unscored runs examined per pass (MongoDB only, no Jupiter cost).
LABELLER_RUN_BATCH_SIZE=100

# Offline backtest (Phase 4) — defaults only, no enable flag.
# Grades intramarket entry→exit trades; resolution is optional context.
BACKTEST_MAX_MARKETS=50
BACKTEST_DECISION_INTERVAL_MINUTES=15
# Minutes to hold a hypothetical position before exiting. Empty = use decision interval.
# BACKTEST_EXIT_HOLD_MINUTES=60
BACKTEST_MIN_SNAPSHOTS=3
BACKTEST_MAX_SNAPSHOTS_PER_MARKET=2000

# Agent fitness (Phase 5) — grades coherent paper trades; Brier secondary.
FITNESS_MAX_RUNS=500
FITNESS_MIN_SAMPLE_FOR_WEIGHT=30
# Unit stake ($) when simulating each specialist's own paper book.
FITNESS_SPECIALIST_STAKE_USD=10

# Adaptive Risk Manager (Phase 6) — how fitness scores move influence away from 1.0.
ADAPTIVE_SENSITIVITY=0.4
ADAPTIVE_RECENT_WINDOW=10
# 0 = jump to new weight each pass; 1 = freeze at previous weight.
ADAPTIVE_INERTIA=0.6
# Pseudocounts on wins/losses so one trade cannot pin win rate at 0 or 1.
ADAPTIVE_WIN_RATE_PRIOR=1

# Paper execution model — keep conservative so backtests are not flattering.
# partial_fill | reject_excess when depth cannot cover the full order.
PAPER_EXCESS_MODE=partial_fill
# Extra adverse slippage after book walk / top-of-book (basis points).
PAPER_SLIPPAGE_BPS=10
# Flat fee on filled notional per leg (basis points).
PAPER_FEE_BPS=0
# Max notional assumed tradeable at top-of-book when no orderbook ladder exists.
PAPER_NO_BOOK_DEPTH_USD=25
# Reject the whole order when filled fraction is below this (0–1).
PAPER_MIN_FILL_FRACTION=0.25

# Continuous live paper trading (PAPER ONLY — never places real orders).
# Consumes collector tips; persists portfolios + adaptive weights in Mongo.
PAPER_TRADING_ENABLED=false
# Gap between paper-trading passes (default 60000 ms = 1 minute).
PAPER_TRADING_INTERVAL_MS=60000
# Minimum minutes between decision-engine runs on the same market.
PAPER_TRADING_DECISION_INTERVAL_MINUTES=15
# Skip new decisions when the latest collector tip is older than this (ms).
PAPER_TRADING_STALE_MS=900000
# Max open markets processed per pass (plus any markets with open positions).
PAPER_TRADING_MAX_MARKETS=24
MONGODB_PAPER_PORTFOLIOS_COLLECTION=paper_portfolios
MONGODB_PAPER_DECISIONS_COLLECTION=paper_decisions
MONGODB_PAPER_CLOSED_TRADES_COLLECTION=paper_closed_trades
MONGODB_ADAPTIVE_WEIGHTS_COLLECTION=adaptive_weights
MONGODB_EVENTS_CATALOG_COLLECTION=events_catalog

# Solana RPC URL for transaction fallback (optional — Phantom submits by default).
# Public mainnet RPC often returns 403 for sendRawTransaction; use a provider URL if needed.
SOLANA_RPC_URL=

# Swarm risk limits used by the Risk Manager agent.
SWARM_MAX_POSITION_USD=100
SWARM_MIN_POSITION_USD=5
SWARM_MIN_CONFIDENCE=0.55
# Safety cap on LangGraph steps so a handoff loop cannot run forever.
SWARM_RECURSION_LIMIT=40
