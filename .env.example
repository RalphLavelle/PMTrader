# Jupiter Prediction API key from https://developers.jup.ag/portal
# Optional for prototyping (keyless access is limited to 0.5 RPS).
JUPITER_API_KEY=jup_166eb08b56f4baf00f66004de67dd582d83f97128204e0c0c4cb282d8f7e66fb

# Default wallet for "My history" queries (Solana public key).
OWNER_PUBKEY=

# API server port (default 3000).
PORT=3000

# Solana RPC URL for transaction fallback (optional — Phantom submits by default).
# Public mainnet RPC often returns 403 for sendRawTransaction; use a provider URL if needed.
SOLANA_RPC_URL=

# LangGraph agent pipeline (optional — scaffold works without OpenAI).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Scheduled market analysis (disabled by default).
AGENT_SCHEDULE_ENABLED=false
AGENT_MARKET_IDS=
AGENT_SCHEDULE_INTERVAL_MS=3600000

# Analysis memory: 'memory' (default, lost on restart) or 'file' (survives restarts).
MEMORY_DRIVER=memory
MEMORY_FILE_PATH=data/analyses.json

# Swarm risk limits used by the Risk Manager agent.
SWARM_MAX_POSITION_USD=100
SWARM_MIN_POSITION_USD=5
SWARM_MIN_CONFIDENCE=0.55
# Safety cap on LangGraph steps so a handoff loop cannot run forever.
SWARM_RECURSION_LIMIT=40
